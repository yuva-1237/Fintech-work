PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fintech_portal?schema=public"
JWT_SECRET="your-super-strong-jwt-secret-key-min-32-chars"
JWT_EXPIRES_IN="7d"
UPLOAD_DIR="./uploads"
FRONTEND_ORIGIN="http://localhost:3000,http://localhost:5173"

# Institutional SMTP Email Service (Section 13)
ENABLE_EMAIL=false
SMTP_HOST=smtp.college.edu
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="Fintech Innovation Team" <noreply@fintech.college.edu>
